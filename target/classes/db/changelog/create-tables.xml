<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-users-table" author="jrlelon">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1000">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_users"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_email"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-rooms-table" author="jrlelon">
        <createTable tableName="rooms">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1000">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_rooms"/>
            </column>
            <column name="room_type" type="VARCHAR(100)"/>
            <column name="room_price" type="NUMERIC(10,2)"/>
            <column name="room_photo_url" type="VARCHAR(1024)"/>
            <column name="room_description" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="003-create-bookings-table" author="jrlelon">
        <createTable tableName="bookings">
            <column name="id" type="BIGINT" autoIncrement="true" startWith="1000">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_bookings"/>
            </column>
            <column name="check_in_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="check_out_date" type="DATE"/>
            <column name="num_of_adults" type="INT" defaultValueNumeric="1"/>
            <column name="num_of_children" type="INT" defaultValueNumeric="0"/>
            <column name="total_num_of_guest" type="INT" defaultValueNumeric="1"/>
            <column name="booking_confirmation_code" type="VARCHAR(255)"/>
            <column name="user_id" type="BIGINT"/>
            <column name="room_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="bookings"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 constraintName="fk_bookings_users"/>

        <addForeignKeyConstraint baseTableName="bookings"
                                 baseColumnNames="room_id"
                                 referencedTableName="rooms"
                                 referencedColumnNames="id"
                                 constraintName="fk_bookings_rooms"/>
    </changeSet>

    <changeSet id="004-create-indexes" author="jrlelon">
        <createIndex indexName="idx_users_email" tableName="users">
            <column name="email"/>
        </createIndex>
        <createIndex indexName="idx_bookings_user_id" tableName="bookings">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="idx_bookings_room_id" tableName="bookings">
            <column name="room_id"/>
        </createIndex>
        <createIndex indexName="idx_bookings_confirmation_code" tableName="bookings">
            <column name="booking_confirmation_code"/>
        </createIndex>
        <createIndex indexName="idx_rooms_room_type" tableName="rooms">
            <column name="room_type"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
